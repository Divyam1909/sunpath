# Copy to .env.local. Names only here: never commit real values.

# Postgres. Pooled URL for the app, direct URL for migrations (same value locally).
DATABASE_URL=
DIRECT_URL=

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Needed outside Vercel, e.g. for `next start` locally
AUTH_TRUST_HOST=

# Secret for HMAC-signing disk-adapter file URLs in local development
FILE_SIGNING_SECRET=

# Vercel Blob (private store). Unset: the disk adapter is used.
BLOB_READ_WRITE_TOKEN=

# Gemini API. Unset: sample bills use the mock reader, other files go to manual entry.
GEMINI_API_KEY=
GEMINI_MODEL=
# auto (default) | gemini | mock
BILL_READER=

# Public base URL for links in messages. Vercel sets its own; needed only elsewhere.
APP_URL=

# Seeding a remote database: path to an env file, and the base URL for seeded message links.
SEED_ENV_FILE=
SEED_APP_URL=
